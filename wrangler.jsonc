{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alli",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b6427050-7fab-4b03-9629-e4a9510481a1","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2ff969d986e34b3b8cee10c4316536a1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
